diff --git a/services/system-sleep/fw-fanctrl-suspend b/services/system-sleep/fw-fanctrl-suspend
index 7a9b49a..f4d0c2e 100755
--- a/services/system-sleep/fw-fanctrl-suspend
+++ b/services/system-sleep/fw-fanctrl-suspend
@@ -1,5 +1,11 @@
 #!/bin/sh
 
+# fw-fanctrl is Framework-specific and may be installed but disabled on
+# other hardware. A system-sleep hook must be a successful no-op in that case.
+if ! /usr/bin/systemctl is-active --quiet fw-fanctrl.service; then
+    exit 0
+fi
+
 case $1 in
     pre)  /usr/bin/python3 "%PYTHON_SCRIPT_INSTALLATION_PATH%" pause ;;
     post) /usr/bin/python3 "%PYTHON_SCRIPT_INSTALLATION_PATH%" resume ;;
